# Copy to `.env` beside this file if you have real credentials. Everything works without
# it — the stack starts, the console loads, and the built-in Databricks-to-REST demo runs
# end to end against the bundled mock.
#
# These are references, not configuration: the definition store holds `env:SF_CLIENT_ID`
# and never the value, so a pipeline can be exported, reviewed and committed without
# carrying a secret with it. That is why they arrive here and nowhere else.
#
# Never commit the filled-in `.env`.

# Any string satisfies the bundled mock warehouse; a real workspace needs a real PAT.
DBX_TOKEN=local-mock-token

# A Salesforce connected app using the client-credentials flow. Leave both empty unless
# you have an org — the Salesforce connector will fail its own connection test with a
# message naming the missing field, and nothing else in the stack is affected.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
