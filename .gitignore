# Build output
target/
build/
dist/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Node
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Logs and local run artefacts
*.log
logs/
app.pid
/backend/apps/dmp-app/*.log

# Credentials — nothing secret belongs in this repo. Connector configs reference
# secrets as env:NAME and the values arrive from the environment at startup.
.env
.env.*
# The template is the opposite: it names the variables and holds none of their values,
# and somebody setting this up on a new machine needs it. `.env.*` was swallowing it.
!.env.example
!*/.env.example
*.pem
*.p12
*.jks
secrets/

# The mock warehouse seeds this on first start — a hundred thousand rows of generated
# orders. Regenerated by deleting it, so committing it would only be a large binary that
# goes stale.
mocks/databricks/orders.db
mocks/databricks/.venv/

# Editors and OS
.idea/
*.iml
.vscode/
.DS_Store

# Local tool settings
.claude/settings.local.json
