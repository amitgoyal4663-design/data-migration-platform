                <groupId>com.dmp</groupId>
                <artifactId>dmp-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-persistence-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-persistence-mongo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-connector-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-connector-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-connector-jdbc</artifactId>
