            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-events-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-transform-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-transform-graaljs</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dmp</groupId>
                <artifactId>dmp-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
