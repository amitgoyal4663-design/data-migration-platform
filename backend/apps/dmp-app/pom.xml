<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dmp</groupId>
        <artifactId>dmp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>dmp-app</artifactId>
    <name>DMP :: App</name>
    <description>
        The single deployable artifact (ADR-0004). Profiles select the role:
        control-plane, worker, or all for local development.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-persistence-postgres</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-persistence-mongo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-engine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-recordlog-opensearch</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-ratelimit-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-events-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-transform-graaljs</artifactId>
        </dependency>
        <!--
            Bundled rather than dropped into plugins/. A platform that ships with no connectors is
            not usable out of the box; third-party connectors still load from the plugin directory
            with their own isolated classloader.
        -->
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-salesforce</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-connector-databricks</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
