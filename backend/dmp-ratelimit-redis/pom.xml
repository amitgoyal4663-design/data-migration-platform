<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dmp</groupId>
        <artifactId>dmp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>dmp-ratelimit-redis</artifactId>
    <name>DMP :: Rate Limit :: Redis</name>
    <description>
        Holds each connector's remaining budget in Redis, so a fleet of workers calls a client's API
        at the rate that client agreed to rather than at that rate multiplied by the number of pods.
        A single Lua script moves both counters at once, which is what makes "enough records AND
        enough calls, or neither" true rather than nearly true.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.dmp</groupId>
            <artifactId>dmp-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
